  "editorial": [
    {
      "id": 692,
      "noun": "Филе трески",
      "ending": "на сковороде",
      "pull": "Его даже не нужно солить",
      "excerpt": "Его не нужно обваливать в муке и жарить в кляре. Его даже не нужно солить. Просто немного прогреть на растительном масле на слабом огне без крышки. Буквально три-четыре минуты."
    },
    {
      "id": 377,
      "noun": "Осьминог",
      "ending": "без секретов",
      "pull": "Не нужно даже наливать воду",
      "excerpt": "Переложите его в кастрюлю, добавьте несколько зубчиков чеснока (можно не чистить) и немного черного перца. Соль, лавровый лист, коренья — не нужны. Не нужно даже наливать воду."
    },
    {
      "id": 360,
      "noun": "Корюшка",
      "ending": "«солнышком»",
      "pull": "Каждая рыба должна облачиться в мучную «шубку»",
      "excerpt": "Выложите рыбу хвостами внахлест к центру сковороды: сначала «крестом», потом «снежинкой», потом более упитанной «снежинкой», и так — пока не получится «солнышко». Жарьте на сильном огне без крышки."
    }
  ],
