{
  "name": "seledkin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:icons": "node scripts/vendor-morphicons.mjs",
    "build:logo-drafts": "node scripts/build-logo-variants.mjs",
    "dev": "python3 -m http.server 4173",
    "lint": "node scripts/build-catalog.mjs --check && node scripts/check-static.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "axe-core": "4.11.1",
    "morphicons": "1.7.1"
  }
}
